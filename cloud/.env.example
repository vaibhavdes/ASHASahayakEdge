# Qdrant Cloud (free cluster). Leave both empty to use a local on-disk Qdrant
# for development (snapshot sync then falls back to plain documents).
QDRANT_URL=
QDRANT_API_KEY=
COLLECTION_PREFIX=eval1_
ENROLL_CODE=
ADMIN_TOKEN=

# Outbreak detection
ZSCORE_THRESHOLD=2.0
MIN_CASES=3
ALERT_RADIUS_KM=6
